PORT=3000

# Option 1: Cloud PostgreSQL (Recommended - e.g., Neon.tech, Supabase)
DATABASE_URL=postgresql://username:password@ep-sample-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# Option 2: Local PostgreSQL (Leave blank if using DATABASE_URL)
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=healthcare_db
PG_USER=postgres
PG_PASSWORD=your_postgres_password

# Authentication
JWT_SECRET_KEY=your_super_secret_jwt_key_here

# Redis Configuration (token blacklisting)
REDIS_USERNAME=default
REDIS_PASSWORD=your_redis_password
REDIS_HOST=localhost
REDIS_PORT=6379
