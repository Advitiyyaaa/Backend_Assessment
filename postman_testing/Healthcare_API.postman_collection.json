            }
          }
        }
      ]
    },
    {
      "name": "Patient-Doctor Mapping APIs",
      "item": [
        {
          "name": "Assign doctor to patient (Patient self-mapping)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"doctorId\": \"{{doctorId}}\",\n  \"notes\": \"Self-assigned consultation\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/mappings",
              "host": ["{{baseUrl}}"],
              "path": ["api", "mappings"]
            }
          }
        },
        {
          "name": "Assign doctor to patient (Admin mapping with both IDs)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"patientId\": \"{{patientId}}\",\n  \"doctorId\": \"{{doctorId}}\",\n  \"notes\": \"Admin assigned appointment\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/mappings",
              "host": ["{{baseUrl}}"],
              "path": ["api", "mappings"]
            }
          }
        },
        {
          "name": "Get all mappings (Role-filtered)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/mappings",
              "host": ["{{baseUrl}}"],
              "path": ["api", "mappings"]
            }
          }
        },
        {
          "name": "Get all doctors assigned to a specific patient",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/mappings/{{patientId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "mappings", "{{patientId}}"]
            }
          }
        },
        {
          "name": "Delete mapping",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/mappings/{{mappingId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "mappings", "{{mappingId}}"]
            }
          }
        }
      ]
    }
  ],
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "patientId", "value": "" },
    { "key": "doctorId", "value": "" },
    { "key": "mappingId", "value": "" }
  ]
}

